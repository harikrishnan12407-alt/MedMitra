<resources>
    <style name="Theme.MedMitra" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#176B55</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F3FAF6</item>
        <item name="android:navigationBarColor">#F3FAF6</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.MedMitra.Launch" parent="Theme.MedMitra">
        <item name="android:windowBackground">#062B24</item>
        <item name="android:statusBarColor">#062B24</item>
        <item name="android:navigationBarColor">#062B24</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Theme.MedMitra.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#062B24</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/medmitra_splash_empty</item>
        <item name="postSplashScreenTheme">@style/Theme.MedMitra.Launch</item>
        <item name="android:windowBackground">#062B24</item>
    </style>
</resources>
