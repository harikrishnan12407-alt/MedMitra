    <string name="app_text_catalog_052" formatted="false">அனுமதி அமைப்பு</string>
    <string name="app_text_catalog_053" formatted="false">Android அணுகல்களையும் தற்போதைய நிலையையும் பார்க்கவும்</string>
    <string name="app_text_catalog_054" formatted="false">சுயவிவர விவரங்கள் இந்தச் சாதனத்தில் சேமிக்கப்படுகின்றன.</string>
    <string name="app_text_catalog_055" formatted="false">மருந்து நினைவூட்டல்</string>
    <string name="app_text_catalog_056" formatted="false">மருந்து எடுத்துக்கொள்ளும் நேரம்</string>
    <string name="app_text_catalog_057" formatted="false">மருந்து நினைவூட்டல்</string>
    <string name="app_text_catalog_058" formatted="false">மருத்துவர் கூறியபடி</string>
    <string name="app_text_catalog_059" formatted="false">இந்த மருந்தளவை எடுத்துவிட்டேன்</string>
    <string name="app_text_catalog_060" formatted="false">5 நிமிடங்களில் மீண்டும் நினைவூட்டவும்</string>
    <string name="app_text_catalog_061" formatted="false">ஒரு செயலைத் தேர்ந்தெடுக்கும் வரை நினைவூட்டல் செயலிலிருக்கும்.</string>
    <string name="app_text_catalog_062" formatted="false">MedMitra-வில் நீங்கள் உருவாக்கும் திட்டமிட்ட நினைவூட்டல்கள்</string>
    <string name="app_text_catalog_063" formatted="false">ஒத்திவைக்கப்பட்ட மருந்து நினைவூட்டல்</string>
    <string name="app_text_catalog_064" formatted="false">5 நிமிடம் ஒத்திவை</string>
    <string name="app_text_catalog_065" formatted="false">மருந்து அலாரம் செயலிலுள்ளது</string>
    <string name="app_text_catalog_066" formatted="false">சேமித்த அட்டவணைகள்</string>
    <string name="app_text_catalog_067" formatted="false">மருந்து நினைவூட்டல்கள் இன்னும் இல்லை</string>
    <string name="app_text_catalog_068" formatted="false">மருந்தையும் அதன் தினசரி நினைவூட்டல் நேரத்தையும் சேர்க்கவும்.</string>
    <string name="app_text_catalog_069" formatted="false">மருந்து நினைவூட்டலைச் சேர்க்கவும்</string>
    <string name="app_text_catalog_070" formatted="false">அறிவிப்பும் அலாரம் அணுகலும்</string>
    <string name="app_text_catalog_071" formatted="false">நினைவூட்டல்கள் இந்தச் சாதனத்தில் சேமிக்கப்படுகின்றன. சரியான நேர அலாரம் அணுகல் முடக்கப்பட்டிருந்தால் அல்லது பேட்டரி கட்டுப்பாடுகள் இருந்தால் Android அவற்றைத் தாமதப்படுத்தலாம்.</string>
    <string name="app_text_catalog_072" formatted="false">அறிவிப்புகள்</string>
    <string name="app_text_catalog_073" formatted="false">அனுமதிக்கப்பட்டது</string>
    <string name="app_text_catalog_074" formatted="false">முடக்கப்பட்டுள்ளது · நினைவூட்டல்கள் தோன்றாமல் போகலாம்</string>
    <string name="app_text_catalog_075" formatted="false">அறிவிப்புகளை இயக்கு</string>
    <string name="app_text_catalog_076" formatted="false">அலாரம் நேரம்</string>
    <string name="app_text_catalog_077" formatted="false">சரியான நேர நினைவூட்டல்கள் அனுமதிக்கப்பட்டுள்ளன</string>
    <string name="app_text_catalog_078" formatted="false">சரியான நேர அணுகல் முடக்கப்பட்டுள்ளது; நினைவூட்டல்கள் தாமதமாகலாம்</string>
    <string name="app_text_catalog_079" formatted="false">சரியான நேர அலாரங்களை அனுமதி</string>
    <string name="app_text_catalog_080" formatted="false">அலாரம் செயல்பாடும் Android அமைப்புகளும்</string>
    <string name="app_text_catalog_081" formatted="false">அலாரம் செயல்பாடு</string>
    <string name="app_text_catalog_082" formatted="false">எடுத்தது அல்லது ஒத்திவை என்பதைத் தேர்ந்தெடுக்கும் வரை அலாரம் ஒலியும் விருப்பக் குரலும் மீண்டும் ஒலிக்கும். ஒத்திவைப்பு 5 நிமிடங்கள். திரை பூட்டப்பட்டிருக்கும்போது, அறிவிப்புகள், உயர் முன்னுரிமை சேனல், முழுத்திரை அணுகல் ஆகியவை இயங்கினால் Android முழுத்திரை அலாரத்தைக் காட்டலாம். திரை திறந்திருக்கும் போது, வேறு செயலியை மறைக்காமல் Android 13 மற்றும் அதற்குப் பிறகு விரிவாக்கப்பட்ட அலாரம் அறிவிப்பைக் காட்டும்; இது Android விதிமுறை.</string>
    <string name="app_text_catalog_083" formatted="false">அறிவிப்புகள் முடக்கப்பட்டுள்ளதால் முழுத்திரை அலாரம் கிடைக்காது.</string>
    <string name="app_text_catalog_084" formatted="false">முழுத்திரை அணுகல் முடக்கப்பட்டுள்ளது. Android அறிவிப்பை மாற்று வழியாகக் காட்டும்.</string>
    <string name="app_text_catalog_085" formatted="false">மருந்து அறிவிப்பு சேனலின் முன்னுரிமை உயர் நிலைக்குக் கீழே உள்ளது.</string>
    <string name="app_text_catalog_086" formatted="false">திரை பூட்டப்பட்டிருக்கும்போது தானியங்கி முழுத்திரைத் திறப்புக்குத் தயாராக உள்ளது. திரை திறந்திருக்கும்போது Android விரிவாக்கப்பட்ட அறிவிப்பைக் காட்டலாம்.</string>
    <string name="app_text_catalog_087" formatted="false">முழுத்திரை அலாரங்களை அனுமதி</string>
    <string name="app_text_catalog_088" formatted="false">மருந்து அறிவிப்பு அமைப்புகளைத் திறக்கவும்</string>
    <string name="app_text_catalog_089" formatted="false">Samsung கைப்பேசிகளில் அலாரங்கள் தாமதமானால் அல்லது தடுக்கப்பட்டால், அமைப்புகள் → செயலிகள் → MedMitra → பேட்டரி என்பதில் “கட்டுப்பாடற்றது” என அமைக்கவும்; பேட்டரி → பின்னணி பயன்பாட்டு வரம்புகள் என்பதில் “ஒருபோதும் உறங்காத செயலிகள்” பட்டியலிலும் சேர்க்கவும். One UI பதிப்புக்கு ஏற்ப பெயர்கள் மாறலாம். முழுத்திரை அமைப்பு அமைப்புகள் → செயலிகள் → சிறப்பு அணுகல் → முழுத்திரை எச்சரிக்கைகள் (அல்லது முழுத்திரை நோக்கங்கள்) என்பதில் இருக்கும்.</string>
    <string name="app_text_catalog_090" formatted="false">இன்று எடுத்தது</string>
    <string name="app_text_catalog_091" formatted="false">இன்று தவறியது · தினசரி</string>
    <string name="app_text_catalog_092" formatted="false">வரவிருக்கிறது · தினசரி</string>
    <string name="app_text_catalog_093" formatted="false">இன்று எடுத்ததாகக் குறிக்கவும்</string>
    <string name="app_text_catalog_094" formatted="false">புதிய மருந்து நினைவூட்டல்</string>
    <string name="app_text_catalog_095" formatted="false">மருந்து நினைவூட்டலைத் திருத்தவும்</string>
    <string name="app_text_catalog_096" formatted="false">மருந்தின் பெயர்</string>
    <string name="app_text_catalog_097" formatted="false">அளவு, உதா. 1 மாத்திரை</string>
