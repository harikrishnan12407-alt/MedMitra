    <string name="app_text_catalog_099" formatted="false">நினைவூட்டல் நேரத்தைத் தேர்ந்தெடுக்கவும்</string>
    <string name="app_text_catalog_100" formatted="false">நேரத்தை அமைக்கவும்</string>
    <string name="app_text_catalog_101" formatted="false">உங்கள் மருந்தை எடுத்துக்கொள்ளும் நேரம்.</string>
    <string name="app_text_catalog_102" formatted="false">செய்தியை முன்னோட்டமிடும்போது குரல் தொடங்கும்.</string>
    <string name="app_text_catalog_103" formatted="false">Android உரை-குரல் வசதி வாசிக்க வேண்டிய செய்தியை உள்ளிடவும். இது உங்கள் குரலைப் பதிவு செய்யாது.</string>
    <string name="app_text_catalog_104" formatted="false">தனிப்பட்ட நினைவூட்டல் செய்தி</string>
    <string name="app_text_catalog_105" formatted="false">முன்னோட்டமிட ஒரு செய்தியை உள்ளிடவும்.</string>
    <string name="app_text_catalog_106" formatted="false">நிறுவப்பட்ட குரல் இயந்திரத்தையும் மொழித் தரவையும் சரிபார்க்கவும்; குரலைத் தொடங்க முடியவில்லை.</string>
    <string name="app_text_catalog_107" formatted="false">முன்னோட்டத்தை இயக்கவும்</string>
    <string name="app_text_catalog_108" formatted="false">குரல் நிறுத்தப்பட்டது.</string>
    <string name="app_text_catalog_109" formatted="false">மருந்து அறிவிப்புகளுடன் பேசு</string>
    <string name="app_text_catalog_110" formatted="false">இயக்கப்பட்டால், திட்டமிட்ட மருந்து நினைவூட்டல் வரும்போது சேமித்த செய்தி வாசிக்கப்படும். செயலி பின்னணியில் இருக்கும்போது அல்லது வேறு ஒலி இயங்கும்போது Android குரலைக் கட்டுப்படுத்தலாம்.</string>
    <string name="app_text_catalog_111" formatted="false">குரல் மொழித் தரவை நிறுவும் செயலி இல்லை.</string>
    <string name="app_text_catalog_112" formatted="false">குரல் மொழித் தரவைச் சரிபார்க்கவும்</string>
    <string name="app_text_catalog_113" formatted="false">உங்கள் பராமரிப்பு, உங்கள் விருப்பம்</string>
    <string name="app_text_catalog_114" formatted="false">MedMitra பயன்படுத்தும் அணுகல்களைப் பாருங்கள். எந்த உருப்படியையும் தவிர்த்து, பின்னர் Android அமைப்புகளில் மாற்றலாம்.</string>
    <string name="app_text_catalog_115" formatted="false">அத்தியாவசிய அணுகல்</string>
    <string name="app_text_catalog_116" formatted="false">திட்டமிட்ட நினைவூட்டல்களையும் அலாரம் கட்டுப்பாடுகளையும் காட்டும்.</string>
    <string name="app_text_catalog_117" formatted="false">சரியான நேர அலாரங்கள்</string>
    <string name="app_text_catalog_118" formatted="false">மருந்து நினைவூட்டல்கள் திட்டமிட்ட நேரத்திற்கு அருகில் செயல்பட உதவும்.</string>
    <string name="app_text_catalog_119" formatted="false">இந்த Android பதிப்பில் தேவையில்லை</string>
    <string name="app_text_catalog_120" formatted="false">அமைப்புகளைத் திறக்கவும்</string>
    <string name="app_text_catalog_121" formatted="false">முழுத்திரை அலாரங்கள்</string>
    <string name="app_text_catalog_122" formatted="false">திரை பூட்டப்பட்டிருக்கும்போது போன்ற சூழல்களில் Android அனுமதித்தால் மருந்து அலாரம் முழுத்திரையாகத் தோன்ற உதவும்.</string>
    <string name="app_text_catalog_123" formatted="false">அனுமதிக்கப்படவில்லை</string>
    <string name="app_text_catalog_124" formatted="false">அறிவிப்பு அமைப்புகளைச் சரிபார்க்கவும்</string>
    <string name="app_text_catalog_125" formatted="false">அணுகலைப் பார்க்கவும்</string>
    <string name="app_text_catalog_126" formatted="false">அவசர உதவி</string>
    <string name="app_text_catalog_127" formatted="false">விருப்பம்</string>
    <string name="app_text_catalog_128" formatted="false">நீங்கள் இயக்கி, SOS-ஐத் தெளிவாகத் தொடங்கும் செயல்களுக்கு மட்டுமே இந்த அனுமதிகள் பயன்படும். இந்தப் பட்டியல் ஒருபோதும் செய்தி அனுப்பவோ அழைக்கவோ செய்யாது.</string>
    <string name="app_text_catalog_129" formatted="false">இடம்</string>
    <string name="app_text_catalog_130" formatted="false">புதிய இடத் தகவல் கிடைத்தால் SOS செய்தியில் தற்போதைய இடத்தைச் சேர்க்கும்.</string>
    <string name="app_text_catalog_131" formatted="false">அனுமதி இல்லை</string>
    <string name="app_text_catalog_132" formatted="false">SMS அனுப்பு</string>
    <string name="app_text_catalog_133" formatted="false">சேமித்த நம்பகமான தொடர்புக்கு தானியங்கி SOS குறுஞ்செய்திகளை இயக்கினால் மட்டுமே தேவை.</string>
    <string name="app_text_catalog_134" formatted="false">அழைப்பு செய்</string>
    <string name="app_text_catalog_135" formatted="false">சேமித்த நம்பகமான தொடர்புக்கு தானியங்கி SOS அழைப்பை இயக்கினால் மட்டுமே தேவை.</string>
    <string name="app_text_catalog_136" formatted="false">விழுதல் பாதுகாப்பும் குரலும்</string>
    <string name="app_text_catalog_137" formatted="false">உடல் இயக்கம் அறிதல்</string>
    <string name="app_text_catalog_138" formatted="false">Android 10 மற்றும் அதற்குப் பிந்தைய பதிப்புகளில் விருப்பத் தேர்வான விழுதல் பாதுகாப்பு பின்னணி சேவை இயக்கத் தகவலைப் பயன்படுத்த உதவும்.</string>
    <string name="app_text_catalog_139" formatted="false">அவசரத் தொடர்புகள்</string>
    <string name="app_text_catalog_140" formatted="false">நம்பகமான தொடர்புகளை MedMitra-வில் நீங்களே உள்ளிடுகிறீர்கள்; சாதன முகவரிப் புத்தகம் வாசிக்கப்படாது.</string>
    <string name="app_text_catalog_141" formatted="false">தொடர்புகள் அனுமதி தேவையில்லை</string>
    <string name="app_text_catalog_142" formatted="false">தேவையில்லை</string>
    <string name="app_text_catalog_143" formatted="false">குரல் நினைவூட்டல்கள்</string>
    <string name="app_text_catalog_144" formatted="false">குரல் நினைவூட்டல்கள் Android உரை-குரல் வசதியைப் பயன்படுத்தும்; ஒலிப்பதிவு செய்யாது.</string>
    <string name="app_text_catalog_145" formatted="false">ஒலிவாங்கி அனுமதி தேவையில்லை</string>
    <string name="app_text_catalog_146" formatted="false">Android செயலி அனுமதி அமைப்புகளைத் திறக்கவும்</string>
    <string name="app_text_catalog_147" formatted="false">Android இனி அனுமதி கேட்கவில்லை என்றால், அமைப்புகள் → செயலிகள் → MedMitra → அனுமதிகள் என்பதற்குச் செல்லவும். சிறப்பு அலாரம் அணுகலுக்கு தனி Android அமைப்புப் பக்கம் திறக்கும். திரும்பும்போது நிலை புதுப்பிக்கப்படும்.</string>
    <string name="app_text_catalog_148" formatted="false">இப்போது வேண்டாம்</string>
    <string name="app_text_catalog_149" formatted="false">துல்லியமான இடம் அனுமதிக்கப்பட்டது</string>
    <string name="app_text_catalog_150" formatted="false">தோராயமான இடம் அனுமதிக்கப்பட்டது</string>
    <string name="app_text_catalog_151" formatted="false">அனுமதி வழங்கப்பட்டது</string>
    <string name="app_text_catalog_152" formatted="false">ஆங்கிலம்</string>
    <string name="app_text_catalog_153" formatted="false">தமிழ்</string>
    <string name="app_text_catalog_154" formatted="false">சேமி</string>
    <string name="app_text_catalog_155" formatted="false">ரத்துசெய்</string>
    <string name="app_text_catalog_156" formatted="false">பின்</string>
    <string name="app_text_catalog_157" formatted="false">முடிந்தது</string>
    <string name="app_text_catalog_158" formatted="false">தொடரவும்</string>
    <string name="app_text_catalog_159" formatted="false">சேமிக்கிறது…</string>
    <string name="app_text_catalog_160" formatted="false">சுயவிவரத்தைப் பின்னர் அமைக்கவும்</string>
    <string name="app_text_catalog_161" formatted="false">சுயவிவரத்தைத் திருத்தவும்</string>
    <string name="app_text_catalog_162" formatted="false">MedMitra-க்கு வரவேற்கிறோம்</string>
    <string name="app_text_catalog_163" formatted="false">உங்கள் விருப்பப்படி சுயவிவரம்</string>
    <string name="app_text_catalog_164" formatted="false">உங்களைப் பற்றி சிறிது</string>
    <string name="app_text_catalog_165" formatted="false">உங்கள் விவரங்களை எப்போது வேண்டுமானாலும் புதுப்பிக்கலாம்.</string>
    <string name="app_text_catalog_166" formatted="false">நினைவூட்டல்களையும் நம்பகமான தொடர்புகளையும் தனிப்பயனாக்குங்கள். உங்கள் விவரங்கள் இந்தச் சாதனத்திலேயே இருக்கும்.</string>
    <string name="app_text_catalog_167" formatted="false">விருப்பப் புகைப்படம்</string>
    <string name="app_text_catalog_168" formatted="false">முழுப் பெயர்</string>
    <string name="app_text_catalog_169" formatted="false">விருப்பமான மொழி</string>
    <string name="app_text_catalog_170" formatted="false">அவசரத் தொடர்பு (விருப்பம்)</string>
    <string name="app_text_catalog_171" formatted="false">அவசரச் செய்திகள் அல்லது அழைப்புகளைப் பெற அவர் ஒப்புக்கொண்டிருந்தால் மட்டுமே இந்த நபரை நம்பகமான தொடர்பாகச் சேமிக்கவும்.</string>
    <string name="app_text_catalog_172" formatted="false">இந்த நபரைச் சேமித்து தொடர்புகொள்ள எனக்கு ஒப்புதல் உள்ளது</string>
    <string name="app_text_catalog_173" formatted="false">தொடர்பின் பெயர்</string>
    <string name="app_text_catalog_174" formatted="false">நாட்டுக் குறியீட்டுடன் தொலைபேசி எண்</string>
    <string name="app_text_catalog_175" formatted="false">சர்வதேச வடிவைப் பயன்படுத்தவும், உதா. +14155550123.</string>
    <string name="app_text_catalog_176" formatted="false">தொடர உங்கள் பெயரை உள்ளிடவும்.</string>
    <string name="app_text_catalog_177" formatted="false">1 முதல் 120 வரையிலான வயதை உள்ளிடவும்.</string>
    <string name="app_text_catalog_178" formatted="false">சரியான சர்வதேச தொலைபேசி எண்ணை உள்ளிடவும் அல்லது எண்ணை காலியாக விடவும்.</string>
    <string name="app_text_catalog_179" formatted="false">தொடர்பின் பெயரையும் எண்ணையும் உள்ளிடவும் அல்லது தொடர்பு ஒப்புதலைத் தேர்வுசெய்ய வேண்டாம்.</string>
    <string name="app_text_catalog_180" formatted="false">சுயவிவரம் சேமிக்கப்பட்டது</string>
    <string name="app_text_catalog_181" formatted="false">சுயவிவரத்தைச் சேமிக்க முடியவில்லை. ஏற்கனவே உள்ள தரவு அழிக்கப்படவில்லை.</string>
    <string name="app_text_catalog_182" formatted="false">சுயவிவர விவரங்களுக்குத் திரும்பு</string>
    <string name="app_text_catalog_183" formatted="false">சுயவிவரப் புகைப்படம்</string>
    <string name="app_text_catalog_184" formatted="false">அவசரத் தொடர்புகள் எதுவும் சேமிக்கப்படவில்லை</string>
    <string name="app_text_catalog_185" formatted="false">SOS செயல்முறையைப் பயன்படுத்தும் முன் நம்பகமான நபரைச் சேர்க்கவும்.</string>
    <string name="app_text_catalog_186" formatted="false">தொடர்பைத் திருத்தவும்</string>
    <string name="app_text_catalog_187" formatted="false">SOS-க்கு கிடைக்கும்</string>
    <string name="app_text_catalog_188" formatted="false">முடக்கப்பட்டது</string>
    <string name="app_text_catalog_189" formatted="false">அவசரத் தொடர்பைச் சேர்க்கவும்</string>
    <string name="app_text_catalog_190" formatted="false">அவசரச் செயல் அமைப்பு</string>
    <string name="app_text_catalog_191" formatted="false">தொடர்புகளும் அவசரச் செயல் விருப்பங்களும் இந்தச் சாதனத்தில் சேமிக்கப்படும். SOS கணக்கெடுப்பு முடிந்ததும், மீண்டும் உறுதிப்படுத்தாமல் தானியங்கி SMS அல்லது அழைப்பு செய்யப்படலாம்.</string>
    <string name="app_text_catalog_192" formatted="false">SOS கணக்கெடுப்புக்குப் பிறகு தானாக SMS அனுப்பு</string>
    <string name="app_text_catalog_193" formatted="false">SOS கணக்கெடுப்புக்குப் பிறகு தேர்ந்தெடுத்த தொடர்பைத் தானாக அழை</string>
    <string name="app_text_catalog_194" formatted="false">கிடைக்கும்போது அவசர SMS-இல் புதிய இடத் தகவலைச் சேர்</string>
    <string name="app_text_catalog_195" formatted="false">தானியங்கி SMS-க்கு Android SEND_SMS அணுகல், செல்லுலார் சேவை, செயலில் உள்ள சந்தா ஆகியவை தேவை. Google Play-இல் உடல் பாதுகாப்பு SMS விதிவிலக்குக்கு ஒப்புதல் தேவை; அது இல்லையெனில் SMS செயலியை மாற்று வழியாகப் பயன்படுத்தவும். அனுப்பும் கோரிக்கை வெற்றியடைந்தாலும் செய்தி சென்றது உறுதி ஆகாது. நேரடி அழைப்பு கூடுதல் உறுதிப்படுத்தல் இல்லாமல் தொடங்கும்; இணைப்பு ஏற்பட்டதா என்பதை இங்கே உறுதிப்படுத்த முடியாது.</string>
    <string name="app_text_catalog_196" formatted="false">அமைப்பில் தேர்ந்தெடுத்த எல்லா அனுமதிகளும் தற்போது வழங்கப்பட்டுள்ளன.</string>
    <string name="app_text_catalog_197" formatted="false">தேர்ந்தெடுத்த அனுமதிகளை வழங்கவும்</string>
    <string name="app_text_catalog_198" formatted="false">இடத் தகவலைப் பாதுகாப்பாகச் சோதிக்க இட அணுகலை வழங்கவும். SMS அல்லது அழைப்பு செய்யப்படவில்லை.</string>
    <string name="app_text_catalog_199" formatted="false">புதிய இடத் தகவலைச் சரிபார்க்கிறது. SMS அல்லது அழைப்புகள் செய்யப்படாது.</string>
    <string name="app_text_catalog_200" formatted="false">புதிய இடத் தகவல் கிடைக்கவில்லை. இடச் சேவைகளையும் இணையத்தையும் சரிபார்க்கவும். SMS அல்லது அழைப்பு செய்யப்படவில்லை.</string>
    <string name="app_text_catalog_201" formatted="false">இடத்தைச் சோதிக்கிறது…</string>
    <string name="app_text_catalog_202" formatted="false">அமைப்பைப் பாதுகாப்பாகச் சோதிக்கவும் (தொடர்புக்கு அல்ல)</string>
    <string name="app_text_catalog_203" formatted="false">நம்பகமான தொடர்பைச் சேர்க்கவும்</string>
    <string name="app_text_catalog_204" formatted="false">உதாரணமாக +14155550123 என்ற சர்வதேச வடிவைப் பயன்படுத்தவும்.</string>
    <string name="app_text_catalog_205" formatted="false">சரியான E.164 எண்ணை உள்ளிடவும்.</string>
    <string name="app_text_catalog_206" formatted="false">உடனடி ஆபத்து இருந்தால் உங்கள் தொலைபேசியின் அவசர எண்ணை அழைக்கவும். இந்த SOS கீழே தேர்ந்தெடுத்த நம்பகமான நபரைத் தொடர்புகொள்ளும்.</string>
    <string name="app_text_catalog_207" formatted="false">தேர்ந்தெடுத்த நம்பகமான தொடர்பு</string>
    <string name="app_text_catalog_208" formatted="false">SOS-க்கு இயக்கப்பட்ட நம்பகமான தொடர்பு இல்லை. அவசரத் தொடர்புகளில் ஒருவரைச் சேர்க்கவும்.</string>
    <string name="app_text_catalog_209" formatted="false">காத்திருக்கவும்</string>
    <string name="app_text_catalog_210" formatted="false">கணக்கெடுப்புக்குப் பிறகு</string>
    <string name="app_text_catalog_211" formatted="false">இடப் பகிர்வு</string>
    <string name="app_text_catalog_212" formatted="false">அனுமதியும் புதிய இடத் தகவலும் இருந்தால் இயக்கப்படும்</string>
    <string name="app_text_catalog_213" formatted="false">தானியங்கி SMS</string>
    <string name="app_text_catalog_214" formatted="false">இயக்கப்பட்டுள்ளது (கூடுதல் உறுதிப்படுத்தல் இல்லாமல் அனுப்பப்படலாம்)</string>
    <string name="app_text_catalog_215" formatted="false">தானியங்கி அழைப்பு</string>
    <string name="app_text_catalog_216" formatted="false">இயக்கப்பட்டுள்ளது (கூடுதல் உறுதிப்படுத்தல் இல்லாமல் அழைக்கும்)</string>
    <string name="app_text_catalog_217" formatted="false">தேர்ந்தெடுத்த நம்பகமான நபரைத் தொடர்புகொள்ள விரும்பினால் மட்டுமே அழுத்தவும். SOS அழுத்தும் வரை எதுவும் தொடங்காது.</string>
    <string name="app_text_catalog_218" formatted="false">SOS ரத்துசெய்யப்பட்டது. அவசரச் செயல்கள் எதுவும் முயற்சிக்கப்படவில்லை.</string>
    <string name="app_text_catalog_219" formatted="false">செயல் நிலை</string>
    <string name="app_text_catalog_220" formatted="false">SMS செயலி திறக்கப்பட்டது. செய்தியை அங்கே பார்த்து அனுப்பவும்.</string>
    <string name="app_text_catalog_221" formatted="false">பொருந்தக்கூடிய SMS செயலி இல்லை.</string>
    <string name="app_text_catalog_222" formatted="false">கைமுறையாக அனுப்ப SMS செயலியைத் திறக்கவும்</string>
    <string name="app_text_catalog_223" formatted="false">தொலைபேசி அழைப்பி திறக்கப்பட்டது. அங்கே அழைப்பை உறுதிப்படுத்தவும்.</string>
    <string name="app_text_catalog_224" formatted="false">பொருந்தக்கூடிய தொலைபேசி அழைப்பி இல்லை.</string>
    <string name="app_text_catalog_225" formatted="false">தொலைபேசி அழைப்பியைத் திறக்கவும்</string>
    <string name="app_text_catalog_226" formatted="false">மற்றொரு SOS-ஐத் தொடங்கவும்</string>
    <string name="app_text_catalog_227" formatted="false">கணக்கெடுப்பு முடிந்ததும் செயல்கள் தொடங்கும்</string>
    <string name="app_text_catalog_228" formatted="false">SOS ரத்துசெய்யப்பட்டது. SMS, அழைப்பு அல்லது இடக் கோரிக்கை செய்யப்படவில்லை.</string>
    <string name="app_text_catalog_229" formatted="false">SOS-ஐ ரத்துசெய்</string>
    <string name="app_text_catalog_230" formatted="false">அமைக்கப்பட்ட அவசரச் செயல்களைச் செயல்படுத்துகிறது…</string>
    <string name="app_text_catalog_231" formatted="false">அவசரச் செயல்கள் முயற்சிக்கப்பட்டன. SMS சென்றதையும் அழைப்பு இணைந்ததையும் இங்கே உறுதிப்படுத்த முடியாது.</string>
    <string name="app_text_catalog_232" formatted="false">உடல் இயக்கம் அறிதல் அனுமதி, உடல்நலப் பின்னணி சேவையைத் தொடங்கத் தேவை.</string>
    <string name="app_text_catalog_233" formatted="false">காணக்கூடிய விழுதல் கண்காணிப்பைத் தொடங்க அறிவிப்புகளை இயக்கு.</string>
    <string name="app_text_catalog_234" formatted="false">பாதுகாப்பான விளக்க எச்சரிக்கையைக் கோருகிறது. SMS அல்லது அழைப்பு செய்யப்படாது.</string>
    <string name="app_text_catalog_235" formatted="false">Android விளக்கப் பின்னணி சேவையைத் தொடங்க முடியவில்லை.</string>
    <string name="app_text_catalog_236" formatted="false">விழுதல் பாதுகாப்பு</string>
    <string name="app_text_catalog_237" formatted="false">முன்னணி கண்காணிப்பு</string>
    <string name="app_text_catalog_238" formatted="false">தொடர்ந்து காணப்படும் அறிவிப்பு இருக்கும் வரை செயலில் இருக்கும்</string>
    <string name="app_text_catalog_239" formatted="false">முன்பு இயக்கப்பட்டது; சேவை நின்றுவிட்டது. கைமுறையாக மீண்டும் தொடங்கவும்.</string>
    <string name="app_text_catalog_240" formatted="false">விழுதல் கண்காணிப்பு நிறுத்தப்பட்டது.</string>
    <string name="app_text_catalog_241" formatted="false">கண்டறிதல் உணர்திறன்</string>
    <string name="app_text_catalog_242" formatted="false">கண்டறிதல் தகவல்</string>
    <string name="app_text_catalog_243" formatted="false">தவறான எச்சரிக்கை கணக்கெடுப்பு</string>
    <string name="app_text_catalog_244" formatted="false">எச்சரிக்கையைச் சோதிக்க அறிவிப்புகளை இயக்கு.</string>
    <string name="app_text_catalog_245" formatted="false">விழுதல் எச்சரிக்கையைச் சோதி (தொடர்புக்கு அல்ல)</string>
    <string name="app_text_catalog_246" formatted="false">மாதிரி விழுதல் எச்சரிக்கை இந்தச் சாதனத்தில் மட்டும் காட்டப்படும். SMS அல்லது அழைப்புகள் செய்யப்படாது.</string>
    <string name="app_text_catalog_247" formatted="false">கண்காணிப்பு தகவல்</string>
    <string name="app_text_catalog_248" formatted="false">கண்காணிப்பு விருப்பத் தேர்வு; இது இயக்க அசைவுகளை மதிப்பிடும் எளிய முறையைப் பயன்படுத்துகிறது. விழுதலைத் தவறவிடலாம் அல்லது சாதாரண அசைவுகளை விழுதலாகக் கருதலாம். இது மருத்துவத் தரமானது அல்ல; அவசரச் சேவைக்கு மாற்றாகாது.</string>
    <string name="app_text_catalog_249" formatted="false">இந்த உடல்நல முன்னணி சேவைக்காக Android உடல் இயக்கம் அறிதல் அனுமதியைக் கேட்கலாம். உணரிக் குறிப்புகள் இந்தச் சாதனத்திலேயே இருக்கும்.</string>
    <string name="app_text_catalog_250" formatted="false">Android பின்னணி வரம்புகள்</string>
    <string name="app_text_catalog_251" formatted="false">இந்தத் திரை திறந்திருக்கும் போதே கண்காணிப்பைத் தொடங்கவும். Android தொடர்ந்து காணப்படும் அறிவிப்புடன் முன்னணி சேவையாக இதை இயக்கும். மறுதொடக்கத்திற்குப் பிறகு MedMitra கண்காணிப்பைத் தானாகத் தொடங்காது; மீண்டும் இயக்கவும்.</string>
    <string name="app_text_catalog_252" formatted="false">முடுக்கமானி, சுழல்மானி, இணைக்கப்பட்ட திசைத் தரவு ஆகியவை கிடைக்கும் உணரிகள் மூலம் சாதனத்திலேயே செயலாக்கப்படும். இந்த அம்சத்துக்கு பின்னணி இடம் அல்லது உடல் உணரி அணுகலை MedMitra கேட்காது.</string>
    <string name="app_text_catalog_253" formatted="false">பேட்டரி மேம்படுத்தல் விலக்கு: அனுமதிக்கப்பட்டது</string>
    <string name="app_text_catalog_254" formatted="false">கடுமையான கட்டுப்பாடுகளில் Android அல்லது கைப்பேசி தயாரிப்பாளர் சேவையை நிறுத்தலாம். கண்காணிப்பு நின்றால் கணினி பேட்டரி அமைப்புகளைப் பாருங்கள்.</string>
    <string name="app_text_catalog_255" formatted="false">குறைந்த உணர்திறன் தவறான எச்சரிக்கைகளைக் குறைக்கும்; ஆனால் நிகழ்வுகளைத் தவறவிடலாம். அதிக உணர்திறன் அதிக எச்சரிக்கைகளை உருவாக்கலாம். கண்காணிப்பு இயங்கும்போதே புதிய அமைப்புகள் பொருந்தும்.</string>
    <string name="app_text_catalog_256" formatted="false">இயக்க அசைவு சந்தேகமாக இருந்தால், “நான் நலமாக இருக்கிறேன்” என்பதை அழுத்தி ரத்துசெய்யும் அறிவிப்பு வரும். கணக்கெடுப்பு முடிந்தால் MedMitra நிகழ்வைப் பதிவுசெய்து SOS-ஐ வழங்கும். அது தானாக செய்தி அனுப்பவோ அழைக்கவோ செய்யாது.</string>
    <string name="app_text_catalog_257" formatted="false">விழுதல் கண்காணிப்பு கிடைக்கவில்லை</string>
    <string name="app_text_catalog_258" formatted="false">இந்தச் சாதனத்தில் முடுக்கமானி இல்லை.</string>
    <string name="app_text_catalog_259" formatted="false">விழுதல் கண்காணிப்பு செயலில் உள்ளது</string>
    <string name="app_text_catalog_260" formatted="false">இந்தச் சாதனத்தில் இயக்கம் கண்காணிக்கப்படுகிறது. நிர்வகிக்கத் தட்டவும்.</string>
    <string name="app_text_catalog_261" formatted="false">கண்காணிப்பை நிறுத்து</string>
    <string name="app_text_catalog_262" formatted="false">விளக்கம் · விழுதல் எச்சரிக்கை இருக்கலாம்</string>
    <string name="app_text_catalog_263" formatted="false">விழுதல் இருக்கலாம்</string>
    <string name="app_text_catalog_264" formatted="false">நான் நலமாக இருக்கிறேன்</string>
    <string name="app_text_catalog_265" formatted="false">விழுதல் எச்சரிக்கை விளக்கம் முடிந்தது</string>
    <string name="app_text_catalog_266" formatted="false">விழுதல் எச்சரிக்கைக்கு கவனம் தேவை</string>
    <string name="app_text_catalog_267" formatted="false">விளக்கம் மட்டும். SMS அல்லது அழைப்பு செய்யப்படவில்லை.</string>
    <string name="app_text_catalog_268" formatted="false">பதில் கிடைக்கவில்லை. அழைப்பு அல்லது செய்தி அனுப்பப்படவில்லை; உதவி தேவைப்பட்டால் SOS-ஐத் திறக்கவும்.</string>
    <string name="app_text_catalog_269" formatted="false">விழுதல் கண்காணிப்பு</string>
    <string name="app_text_catalog_270" formatted="false">விழுதல் எச்சரிக்கைகள்</string>
    <string name="app_text_catalog_271" formatted="false">மருந்து அலாரம் செயலில் உள்ளது</string>
    <string name="app_text_catalog_272" formatted="false">மருந்து</string>
    <string name="app_text_catalog_273" formatted="false">அளவு</string>
    <string name="app_text_catalog_274" formatted="false">திட்டமிட்ட நேரம்</string>
    <string name="app_text_catalog_275" formatted="false">மருந்துகள்</string>
    <string name="app_text_catalog_276" formatted="false">குரல்</string>
    <string name="app_text_catalog_277" formatted="false">தொடர்புகள்</string>
    <string name="app_text_catalog_278" formatted="false">வரலாறு</string>
    <string name="app_text_catalog_279" formatted="false">அனுமதி முடிவுகளை Android சேமித்துள்ளது. தற்போதைய அணுகலைக் கீழே பார்க்கவும்.</string>
    <string name="app_text_catalog_280" formatted="false">கோரிய அனுமதிகள் எதுவும் வழங்கப்படவில்லை. Android அமைப்புகளில் இயக்கும் வரை தானியங்கி செயல்கள் கிடைக்காது.</string>
    <string name="app_text_catalog_281" formatted="false">நம்பகமான தொடர்பைத் திருத்து</string>
    <string name="app_text_catalog_282" formatted="false">கோரப்படவில்லை</string>
    <string name="app_text_catalog_283" formatted="false">முயற்சிக்கப்படவில்லை</string>
    <string name="app_text_catalog_284" formatted="false">வானொலி அமைப்பு ஏற்றுக்கொண்டது; சென்றடைந்ததா தெரியாது</string>
    <string name="app_text_catalog_285" formatted="false">செல்லுலார் சேவை இல்லை</string>
    <string name="app_text_catalog_286" formatted="false">செல்லுலார் சேவை இல்லாததால் SMS அனுப்ப முடியவில்லை.</string>
    <string name="app_text_catalog_287" formatted="false">வானொலி அணைக்கப்பட்டுள்ளது</string>
    <string name="app_text_catalog_288" formatted="false">செல்லுலார் வானொலி அணைக்கப்பட்டுள்ளதால் SMS அனுப்ப முடியவில்லை.</string>
    <string name="app_text_catalog_289" formatted="false">SMS அனுப்ப முடியவில்லை என Android தெரிவித்தது. கீழே உள்ள செய்தி அனுப்பும் மாற்று வழியைப் பயன்படுத்தவும்.</string>
    <string name="app_text_catalog_290" formatted="false">SOS தொடங்குவதற்கு முன் சரியான நம்பகமான தொடர்பைச் சேர்த்து இயக்கவும்.</string>
    <string name="app_text_catalog_291" formatted="false">தேர்வின்படி முடக்கப்பட்டுள்ளது</string>
    <string name="app_text_catalog_292" formatted="false">வரலாற்றைச் சேமிக்க எடுத்த நேரம் கணக்கெடுப்பு வரம்பை மீறியதால் எந்தச் செயலும் முயற்சிக்கப்படவில்லை</string>
    <string name="app_text_catalog_293" formatted="false">வரலாற்றைச் சேமிக்க முடியாததால் SOS ரத்து செய்யப்பட்டது. தொடர்புக்கு எந்தச் செயலும் முயற்சிக்கப்படவில்லை.</string>
    <string name="app_text_catalog_294" formatted="false">தேர்ந்தெடுத்த தொடர்பு அல்லது வரலாற்றுப் பதிவு கிடைக்காததால் அவசரச் செயல் முயற்சிக்கப்படவில்லை.</string>
    <string name="app_text_catalog_295" formatted="false">அனுமதி கிடைக்கவில்லை</string>
    <string name="app_text_catalog_296" formatted="false">கிடைக்கவில்லை (GPS/இணையம் முடக்கப்பட்டிருக்கலாம்)</string>
    <string name="app_text_catalog_297" formatted="false">புதிய இருப்பிடம் கிடைக்கிறது</string>
    <string name="app_text_catalog_298" formatted="false">அனுமதி இல்லை; கீழே உள்ள மாற்று வழியைப் பயன்படுத்தவும்</string>
    <string name="app_text_catalog_299" formatted="false">SMS வன்பொருள் அல்லது சந்தா கிடைக்கவில்லை</string>
    <string name="app_text_catalog_300" formatted="false">எனக்கு உதவி தேவை. தயவுசெய்து என்னைத் தொடர்புகொள்ளுங்கள்.</string>
    <string name="app_text_catalog_301" formatted="false">Android-க்கு அனுப்பப்பட்டது; சென்றடைந்தது உறுதிப்படுத்தப்படவில்லை</string>
    <string name="app_text_catalog_302" formatted="false">அனுப்ப முடியவில்லை; கீழே உள்ள மாற்று வழியைப் பயன்படுத்தவும்</string>
    <string name="app_text_catalog_303" formatted="false">அழைப்பு தொடங்கியது; இணைப்பு நிலை தெரியாது</string>
    <string name="app_text_catalog_304" formatted="false">தொடங்க முடியவில்லை; கீழே உள்ள மாற்று வழியைப் பயன்படுத்தவும்</string>
    <string name="app_text_catalog_305" formatted="false">அமைத்த செயல்களில் ஒன்று அல்லது அதற்கு மேற்பட்டவை தொடங்கவில்லை. அனுமதி, SIM/சேவை மற்றும் கீழே உள்ள மாற்று வழிகளைச் சரிபார்க்கவும்.</string>
    <string name="app_text_catalog_306" formatted="false">ஐந்து விநாடி ரத்து கணக்கெடுப்புடன் SOS தொடங்கு</string>
    <string name="app_text_catalog_307" formatted="false">எச்சரிக்கையின்போது விழுதல் கண்காணிப்பு நிறுத்தப்பட்டது</string>
    <string name="app_text_catalog_308" formatted="false">பாதுகாப்பான விளக்க எச்சரிக்கை; அவசரச் செயல் எதுவும் தொடங்கப்படவில்லை</string>
    <string name="app_text_catalog_309" formatted="false">விழுதல் இருக்கலாம் எனக் கண்டறியப்பட்டது; அவசரச் செயல் தொடங்கப்படவில்லை</string>
    <string name="app_text_catalog_310" formatted="false">வரலாறு சேமிக்கப்படுவதற்கு முன் எச்சரிக்கை உறுதிப்படுத்தப்பட்டது</string>
    <string name="app_text_catalog_311" formatted="false">பாதுகாப்பான விளக்கம் முடிந்தது; அழைப்போ செய்தியோ அனுப்பப்படவில்லை</string>
    <string name="app_text_catalog_312" formatted="false">விழுதல் எச்சரிக்கைக்கு பதில் இல்லை; அழைப்போ செய்தியோ அனுப்பப்படவில்லை</string>
    <string name="app_text_catalog_313" formatted="false">முன்னணி கண்காணிப்பு தொடங்குகிறது. சேவை உணரிகளைப் பதிவு செய்த பிறகு செயலில் இருப்பது காட்டப்படும்.</string>
    <string name="app_text_catalog_314" formatted="false">விழுதல் கண்காணிப்பை Android தடுத்தது. அறிவிப்பு மற்றும் செயல்பாட்டு அனுமதிகளைச் சரிபார்த்து மீண்டும் முயற்சிக்கவும்.</string>
    <string name="app_text_catalog_315" formatted="false">MedMitra திரையில் தெரியும் போது மட்டுமே விழுதல் கண்காணிப்பைத் தொடங்க முடியும். இந்தத் திரைக்குத் திரும்பி மீண்டும் முயற்சிக்கவும்.</string>
    <string name="app_text_catalog_316" formatted="false">உடல்நல முன்னணி சேவைக்கு செயல்பாட்டு அறிதல் அனுமதி தேவை.</string>
    <string name="app_text_catalog_317" formatted="false">அறிவிப்புகளை இயக்கி, இங்கு திரும்பி, கண்காணிப்பைத் தொடங்கவும்.</string>
    <string name="app_text_catalog_318" formatted="false">எச்சரிக்கையைச் சோதிப்பதற்கு முன் அறிவிப்புகளை இயக்கவும்.</string>
    <string name="app_text_catalog_319" formatted="false">உறக்கநிலை</string>
    <string name="app_text_catalog_320" formatted="false">குறைவு</string>
    <string name="app_text_catalog_321" formatted="false">நடுத்தரம்</string>
    <string name="app_text_catalog_322" formatted="false">அதிகம்</string>
    <string name="app_text_catalog_323" formatted="false">மீண்டும் வரவேற்கிறோம்</string>
    <string name="app_text_catalog_324" formatted="false">எனது தற்போதைய இருப்பிடம்</string>
    <string name="app_text_catalog_325" formatted="false">இருப்பிடம் கிடைக்கவில்லை.</string>
    <string name="app_text_catalog_326" formatted="false">தொடர்பை நீக்கு</string>
    <string name="app_text_catalog_327" formatted="false">சுருக்கு</string>
    <string name="app_text_catalog_328" formatted="false">விரி</string>
    <string name="app_text_catalog_329" formatted="false">இந்த நபரின் விவரங்களைச் சேமித்து தொடர்புகொள்ள எனக்கு ஒப்புதல் உள்ளது</string>
    <string name="app_text_catalog_330" formatted="false">கணக்கெடுப்பின்போது ரத்து செய்யப்பட்டது; SMS அல்லது அழைப்பு முயற்சிக்கப்படவில்லை</string>
    <string name="app_text_catalog_331" formatted="false">விழுதல் இருக்கலாம் என்ற எச்சரிக்கையை பயனர் உறுதிப்படுத்தினார்</string>
    <string name="app_text_catalog_332" formatted="false">இயக்கத்தில் விழுதல் இருக்கலாம் எனத் தோன்றினால் “நான் நலமாக இருக்கிறேன்” என்று ரத்துசெய்யும் அறிவிப்பு வரும். தவறான எச்சரிக்கையை ரத்துசெய்யத் தேர்ந்தெடுத்த கணக்கெடுப்பு நேரம் உதவும். அது முடிந்தால் MedMitra நிகழ்வைப் பதிவு செய்து SOS விருப்பத்தைக் காட்டும். தானாக செய்தி அனுப்பவோ அழைக்கவோ செய்யாது.</string>
    <string name="app_text_catalog_333" formatted="false">எனது தற்போதைய இருப்பிடம்</string>
    <string name="app_text_catalog_334" formatted="false">இருப்பிடம் கிடைக்கவில்லை.</string>
    <string name="app_text_catalog_335" formatted="false">தொடர்பை நீக்கு</string>
    <string name="app_text_catalog_336" formatted="false">மருந்து நினைவூட்டல்கள்</string>
    <string name="app_text_catalog_337" formatted="false">உங்கள் ஆரோக்கியம், எங்கள் அக்கறை</string>
    <string name="app_text_catalog_338" formatted="false">சுயவிவரத்தைச் சேமி</string>
    <string name="app_text_catalog_339" formatted="false">மருந்து நினைவூட்டல்கள்</string>
    <string name="app_text_catalog_340" formatted="false">மருந்தைத் திருத்து</string>
    <string name="app_text_catalog_341" formatted="false">மருந்தை நீக்கு</string>
    <string name="app_text_catalog_342" formatted="false">மருத்துவக் குறி</string>
