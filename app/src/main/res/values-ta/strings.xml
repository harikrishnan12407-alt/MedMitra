    <string name="app_text_catalog_000" formatted="false">முகப்பு</string>
    <string name="app_text_catalog_001" formatted="false">செயல்பாடு</string>
    <string name="app_text_catalog_002" formatted="false">சுயவிவரம்</string>
    <string name="app_text_catalog_003" formatted="false">மருந்து நினைவூட்டல்கள்</string>
    <string name="app_text_catalog_004" formatted="false">உங்கள் தினசரி அட்டவணை</string>
    <string name="app_text_catalog_005" formatted="false">குரல் நினைவூட்டல்கள்</string>
    <string name="app_text_catalog_006" formatted="false">தனிப்பட்ட நினைவூட்டல்கள்</string>
    <string name="app_text_catalog_007" formatted="false">அவசரத் தொடர்புகள்</string>
    <string name="app_text_catalog_008" formatted="false">நீங்கள் நம்பும் நபர்கள்</string>
    <string name="app_text_catalog_009" formatted="false">அவசர உதவி</string>
    <string name="app_text_catalog_010" formatted="false">உதவியும் பாதுகாப்பும்</string>
    <string name="app_text_catalog_011" formatted="false">விழுதல் கண்டறிதல்</string>
    <string name="app_text_catalog_012" formatted="false">விழுதல் பாதுகாப்பு</string>
    <string name="app_text_catalog_013" formatted="false">இந்த வசதியைப் பாருங்கள்</string>
    <string name="app_text_catalog_014" formatted="false">அவசர வரலாறு</string>
    <string name="app_text_catalog_015" formatted="false">சமீபத்திய செயல்பாடு</string>
    <string name="app_text_catalog_016" formatted="false">இன்றைய மருந்துகள்</string>
    <string name="app_text_catalog_017" formatted="false">அட்டவணையைப் பார்க்கவும்</string>
    <string name="app_text_catalog_018" formatted="false">உங்கள் குறுக்குவழிகள்</string>
    <string name="app_text_catalog_019" formatted="false">அவசர உதவி செயல்கள் நீங்கள் சேமித்த ஒப்புதல் அமைப்புகளைப் பின்பற்றும். விழுதல் கண்காணிப்பும் குரல் நினைவூட்டல்களும் விருப்பத் தேர்வுகள்.</string>
    <string name="app_text_catalog_020" formatted="false">உங்கள் தினசரி நலம்</string>
    <string name="app_text_catalog_021" formatted="false">MedMitra-க்கு வரவேற்கிறோம்</string>
    <string name="app_text_catalog_022" formatted="false">உங்கள் உடல்நலம் — ஒரு பார்வையில்</string>
    <string name="app_text_catalog_023" formatted="false">இன்றைய திட்டம்</string>
    <string name="app_text_catalog_024" formatted="false">இன்று மருந்துகள் எதுவும் திட்டமிடப்படவில்லை.</string>
    <string name="app_text_catalog_025" formatted="false">மருந்தைச் சேர்க்கவும்</string>
    <string name="app_text_catalog_026" formatted="false">உங்கள் ஆரோக்கியமான பழக்கத்தைத் தொடருங்கள்</string>
    <string name="app_text_catalog_027" formatted="false">உதவி வேண்டுமா?</string>
    <string name="app_text_catalog_028" formatted="false">ரத்துசெய்யக்கூடிய அவசர உதவியைத் தொடங்கவும்</string>
    <string name="app_text_catalog_029" formatted="false">திறக்கவும்</string>
    <string name="app_text_catalog_030" formatted="false">செயல்பாடு எதுவும் இதுவரை பதிவு செய்யப்படவில்லை</string>
    <string name="app_text_catalog_031" formatted="false">எடுத்தது</string>
    <string name="app_text_catalog_032" formatted="false">ஒத்திவைக்கப்பட்டது</string>
    <string name="app_text_catalog_033" formatted="false">மருந்து எடுத்ததாகக் குறிக்கப்பட்டது</string>
    <string name="app_text_catalog_034" formatted="false">அவசர உதவி தொடங்கியது</string>
    <string name="app_text_catalog_035" formatted="false">அவசர உதவி ரத்துசெய்யப்பட்டது</string>
    <string name="app_text_catalog_036" formatted="false">அவசர உதவி செயல்கள் திறக்கப்பட்டன</string>
    <string name="app_text_catalog_037" formatted="false">அவசர உதவி செயல்முறை முடிந்தது</string>
    <string name="app_text_catalog_038" formatted="false">விழுதல் இருக்கலாம்</string>
    <string name="app_text_catalog_039" formatted="false">விழுதல் எச்சரிக்கை உறுதிப்படுத்தப்பட்டது</string>
    <string name="app_text_catalog_040" formatted="false">விழுதல் எச்சரிக்கைக்கு பதில் இல்லை</string>
    <string name="app_text_catalog_041" formatted="false">பாதுகாப்பான விழுதல் விளக்கம் தொடங்கியது</string>
    <string name="app_text_catalog_042" formatted="false">பாதுகாப்பான விழுதல் விளக்கம் உறுதிப்படுத்தப்பட்டது</string>
    <string name="app_text_catalog_043" formatted="false">பாதுகாப்பான விழுதல் விளக்கம் ரத்துசெய்யப்பட்டது</string>
    <string name="app_text_catalog_044" formatted="false">பாதுகாப்பான விழுதல் விளக்கம் முடிந்தது</string>
    <string name="app_text_catalog_045" formatted="false">உங்கள் சுயவிவரம்</string>
    <string name="app_text_catalog_046" formatted="false">உங்கள் வயதைச் சேர்க்கவும்</string>
    <string name="app_text_catalog_047" formatted="false">சுயவிவரத்தைத் திருத்தவும்</string>
    <string name="app_text_catalog_048" formatted="false">உங்கள் பராமரிப்பு அமைப்புகள்</string>
    <string name="app_text_catalog_049" formatted="false">குரல் நினைவூட்டல் செய்தி</string>
